{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Tab Transcriber",
  "version": "0.1.0",
  "identifier": "com.tabtranscriber.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Tab Transcriber",
        "width": 1180,
        "height": 780,
        "minWidth": 900,
        "minHeight": 620
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "category": "Music",
    "shortDescription": "Transcritor musical local com loopback Core Audio, HTDemucs 6-stems e AlphaTab.",
    "resources": {
      "../../../models/nmp.onnx": "models/nmp.onnx",
      "../../../scripts/separate_stems.py": "scripts/separate_stems.py",
      "../../../scripts/transcribe_neural.py": "scripts/transcribe_neural.py"
    },
    "macOS": {
      "minimumSystemVersion": "14.2",
      "frameworks": [],
      "entitlements": null
    }
  }
}
